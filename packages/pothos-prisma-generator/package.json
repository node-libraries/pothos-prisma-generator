{
  "name": "pothos-prisma-generator",
  "version": "1.3.11",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/cjs/index.js",
      "import": "./dist/esm/index.js"
    },
    "./test": {
      "default": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      }
    }
  },
  "typesVersions": {
    "*": {
      "test": [
        "./src/index.ts"
      ],
      "*": [
        "./dist/cjs/index.d.ts"
      ]
    }
  },
  "bin": {
    "pothos-prisma-generator": "./bin/pothos-prisma-generator.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc && tsc -p ./tsconfig.esm.json && cpy esm dist",
    "watch": "tsc -b -w",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src"
  },
  "dependencies": {
    "@prisma/generator-helper": "7.10.1",
    "graphql-scalars": "^2.0.1",
    "json5": "^2.2.3",
    "traverse": "0.6.14"
  },
  "devDependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/fastify": "^3.1.0",
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-generic-sdk": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-prisma": "^4.17.0",
    "@pothos/plugin-prisma-utils": "^1.3.6",
    "@pothos/plugin-scope-auth": "^4.2.2",
    "@prisma/client": "^7.10.1",
    "@types/traverse": "^0.6.37",
    "cpy-cli": "^7.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "graphql": "^17.1.0",
    "graphql-tag": "^2.12.7",
    "next-exec": "^1.0.1",
    "ts-node-dev": "^2.0.0",
    "ts-patch": "^4.0.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript-transform-paths": "^4.0.0"
  },
  "author": "SoraKumo <info@croud.jp>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/node-libraries/pothos-prisma-generator.git"
  },
  "description": "Automatic generation of GraphQL schema from prisma schema.",
  "keywords": [
    "graphql",
    "photos",
    "prisma"
  ],
  "homepage": "https://github.com/node-libraries/pothos-prisma-generator/tree/master/packages/pothos-prisma-generator"
}
