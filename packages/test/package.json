{
  "name": "@/test",
  "version": "1.0.7",
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    "require": "./dist/cjs/index.js",
    "import": "./dist/esm/index.js"
  },
  "license": "MIT",
  "private": true,
  "scripts": {
    "test": "pnpm docker:start && pnpm prisma:migrate && pnpm prisma:seed && next-exec -c test -- vitest run --coverage",
    "test:reset": "pnpm run prisma:reset && pnpm run prisma:seed",
    "test:actions": "next-exec -c test -- vitest run --coverage",
    "server": "next-exec -c test -- tsx --watch bin/server.ts",
    "lint": "npx eslint ./tests",
    "lint:fix": "eslint --fix ./tests",
    "docker:start": "docker compose -p pothos-prisma-generator -f docker/docker-compose.yml up -d",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "prisma:migrate": "next-exec -c test -- prisma migrate dev -n migrate",
    "prisma:reset": " next-exec -c test -- prisma migrate reset --schema=prisma/schema.prisma -f",
    "prisma:seed": "next-exec -c test -- tsx bin/seeds",
    "prisma:test": "next-exec -c test -- tsx bin/test",
    "pothos:schema": "tsx bin/createSchema",
    "codegen": "graphql-codegen --config codegen/codegen.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-generic-sdk": "^5.0.1",
    "@graphql-codegen/typescript-operations": "^6.2.0",
    "@graphql-tools/executor-http": "3.6.0",
    "@hono/graphql-server": "0.7.1",
    "@hono/node-server": "2.1.6",
    "@pothos/core": "^4.16.0",
    "@pothos/plugin-prisma": "^4.17.0",
    "@pothos/plugin-prisma-utils": "^1.3.6",
    "@pothos/plugin-scope-auth": "^4.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/pg": "^8.23.1",
    "@types/traverse": "^0.6.37",
    "@vitest/coverage-v8": "^4.1.4",
    "cpy-cli": "^7.0.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "graphql": "^17.1.0",
    "graphql-tag": "^2.12.7",
    "hono": "4.13.16",
    "next-exec": "^1.0.1",
    "pg": "^8.23.1",
    "pothos-prisma-generator": "workspace:*",
    "pothos-schema-exporter": "^1.0.0",
    "prisma": "^7.10.1",
    "ts-patch": "^4.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.1",
    "typescript-transform-paths": "^4.0.0",
    "vitest": "^4.1.4"
  },
  "author": "SoraKumo <info@croud.jp>",
  "repository": "https://github.com/node-libraries/pothos-prisma-generator"
}
